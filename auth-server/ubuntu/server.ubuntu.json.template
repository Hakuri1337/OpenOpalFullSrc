{
  "ListenHost": "0.0.0.0",
  "HttpPort": 80,
  "HttpsPort": 443,
  "EnableHttp": false,
  "PublicBaseUrl": "https://__ORACULUS_DOMAIN__",
  "AllowedHosts": ["__ORACULUS_DOMAIN__"],
  "DataDirectory": "/var/lib/oraculus-auth",
  "AccessTokenMinutes": 10,
  "RefreshTokenDays": 7,
  "WebSessionHours": 8,
  "SecureCookies": true,
  "RequireHttps": true,
  "RegistrationEnabled": true,
  "AllowedClientVersions": ["b5"],
  "AllowedBuildIds": ["b5-free", "b5-beta"],
  "TlsCertificatePath": "/var/lib/oraculus-auth/certificates/__ORACULUS_DOMAIN__.crt",
  "TlsPrivateKeyPath": "/var/lib/oraculus-auth/certificates/__ORACULUS_DOMAIN__.key"
}
