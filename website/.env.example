# 与 Auth 服务端 server.json 中的 InternalWebsiteSecret 必须完全一致，且至少 32 位。
ORACULUS_WEBSITE_SECRET=replace-with-a-unique-32-plus-character-secret

# 仅供 Next.js BFF 在同一台机器上调用；不能填写浏览器可见地址。
# 与 Auth 同机时使用 http://127.0.0.1:3101；独立官网服务器时使用
# https://auth.hakuri.tech:3101，并仅允许官网服务器 IP 访问该端口。
AUTH_INTERNAL_URL=http://127.0.0.1:3101

# 生产环境的公开网站地址。
NEXT_PUBLIC_SITE_URL=https://oraculus.hakuri.tech
